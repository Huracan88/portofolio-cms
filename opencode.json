{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode/ling-3.0-tiny-free",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".agents/skills"]
  },
  "mcp": {
    "laravel-boost": {
      "type": "local",
      "command": [
        "C:\\Users\\Andres\\.config\\herd\\bin\\php83\\php.exe",
        "artisan",
        "boost:mcp"
      ],
      "cwd": ".",
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 30000
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "php artisan test *": "allow",
      "php artisan pint *": "allow",
      "vendor/bin/pint *": "allow",
      "composer test *": "allow",
      "npm run build": "allow",
      "npm run dev": "allow",
      "npm run lint *": "allow",
      "docker ps*": "allow",
      "docker compose ps*": "allow"
    }
  }
}

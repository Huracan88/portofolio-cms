      "php artisan pint *": "allow",
      "vendor/bin/pint *": "allow",
      "composer test *": "allow",
      "npm run build": "allow",
      "npm run dev": "allow",
      "npm run lint *": "allow",
      "docker ps*": "allow",
      "docker compose ps*": "allow"
    }
  }
}
